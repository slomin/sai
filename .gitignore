.DS_Store

# Local leftovers of the Go prototype (binary, deploy output, venv) and
# any future compile output at the root. Anchored on purpose.
/sai
/build/
/.venv/
/dist/

# Reference clones (not our code)
ref_code_examples_only/

# Local reference material (not our code)
/references/

# Dart / Flutter
.dart_tool/

# Never a Things 3 database, its WAL, or a scratch copy — private data in
# a public repository (#18). Test fixtures are generated, never committed.
*.sqlite*
*.thingsdatabase/

# Per-machine Xcode signing overrides (ADR 0008)
apps/sai_app/macos/Runner/Configs/Local.xcconfig

# Claude Code project settings are shared (#56); the global ignore hides
# .claude, so re-include just the committed file.
!/.claude/
/.claude/*
!/.claude/settings.json
