#!/bin/sh
# Strip tool-generated attribution from commit messages.
# Policy: commits in this repository are authored solely by the person
# committing. Patterns live in attribution-patterns (case-insensitive ERE,
# one per line) and are shared with pre-push and the CI attribution job.
# Install with: git config core.hooksPath .githooks

msg_file="$1"
patterns="$(dirname "$0")/attribution-patterns"
tmp="$msg_file.tmp"

# Drop matching lines. grep -v exits 1 when nothing is left, which is fine.
grep -viE -f "$patterns" "$msg_file" > "$tmp"
status=$?
if [ "$status" -gt 1 ]; then
  echo "commit-msg: could not filter the message (grep exit $status)" >&2
  rm -f "$tmp"
  exit 1
fi

# Collapse any trailing blank lines left behind by the deletions.
awk '{lines[NR]=$0} END{last=NR; while(last>0 && lines[last]~/^[[:space:]]*$/) last--; for(i=1;i<=last;i++) print lines[i]}' \
  "$tmp" > "$msg_file" && rm -f "$tmp"
